# MiniMax 接入方式（三选一，按优先级）
# 1) 填 MINIMAX_API_KEY -> 官方 API 实时调用（mode=real）
# 2) 留空 + 仓库内有 patches/index.json -> 复用本次 MiniMax 编码助手会话产出的补丁（mode=assistant_session）
# 3) 都没有 -> 确定性 MockClient（mode=mock，验收第 2 项记为 SKIP，不计分）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# PowerContext Server 地址与端口
POWERCONTEXT_URL=http://127.0.0.1:8311
POWERCONTEXT_PORT=8311

# 数据库后端：seekdb（默认，embedded seekdb，Linux/macOS）或 sqlite（可移植回退）
DATABASE_KIND=seekdb
