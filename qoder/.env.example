# 配置示例（占位值，不要提交真实凭据）
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除

# PowerContext Server 地址与端口（默认 8312，避免与其它样例的 8311 冲突）
POWERCONTEXT_PORT=8312
POWERCONTEXT_URL=http://127.0.0.1:8312

# 数据库后端：seekdb（默认，需要 Linux 环境）或 sqlite（仅用于临时调试）
DATABASE_KIND=seekdb

# PowerContext 源码位置（留空则由 bootstrap.sh 自动准备）
# POWERCONTEXT_SRC=/path/to/powercontext/src

# 虚拟环境位置（留空则用 qoder/.venv）
# POWERCONTEXT_VENV=/path/to/venv

# 本地 WSL 开发专用：seekdb 不能放在 /mnt/d（drvfs 不支持 fallocate）。
# 执行 scripts/dev-setup-wsl.sh 会自动把下面两行写进 .env；
# 评测环境是原生 Linux，不需要设置。
# RCA_SEEKDB_PATH=/var/lib/rca/seekdb
# RCA_PC_HOME=/var/lib/rca/pc
